                {
                    "key": "field_5d08ac7bbb892",
                    "label": "Please Note",
                    "name": "",
                    "type": "message",
                    "instructions": "",
                    "required": 0,
                    "conditional_logic": 0,
                    "wrapper": {
                        "width": "100",
                        "class": "",
                        "id": ""
                    },
                    "message": "<p>Please only fill in either one of the Include or Exclude list for each popup. The outcome of these fields are:<\/p>\r\n<ul>\r\n<li><strong>Include:<\/strong> Exclude on all pages* except those on the Include list<\/li>\r\n<li><strong>Exclude:<\/strong> Include on all pages* except those on the Exclude list<\/li>\r\n<li><strong>Both empty:<\/strong> Include on all pages*<\/li>\r\n<\/ul>\r\n\r\n<p><strong>Filling in both lists will result in a nullified outcome; any item on both lists will be excluded rendering its place on the Include list pointless, and any item not on the Include list will be excluded rendering its place on the Exclude list pointless.<\/strong><\/p>\r\n\r\n<p>Any popups sharing the same page\/post-type will show the first available popup. When that popup is closed a cookies is set to keep it hidden, and when the visitor navigates to the next page, the next available popup will appear.<\/p>\r\n\r\n<p>*<em style=\"font-size: 10px\">Does not include News, Blog or Vacancies post types; these are selected using the \"Include On\" selection.<\/em><\/p>",
                    "new_lines": "",
                    "esc_html": 0
                },
